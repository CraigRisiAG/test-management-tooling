{
  "name": "zebrunner-platform",
  "version": "2.6.0",
  "description": "Zebrunner test management platform - Docker orchestration and management tool",
  "main": "dist/index.js",
  "bin": {
    "zebrunner": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "package": "npm run build && npm pack",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zebrunner",
    "test-management",
    "docker",
    "automation",
    "testing",
    "ci-cd"
  ],
  "author": "Zebrunner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "yaml": "^2.3.4",
    "shelljs": "^0.8.5",
    "boxen": "^7.1.1",
    "figlet": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@types/inquirer": "^9.0.7",
    "@types/shelljs": "^0.8.15",
    "@types/figlet": "^1.5.8",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "prettier": "^3.1.1"
  }
}
