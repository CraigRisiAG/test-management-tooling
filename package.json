{
  "name": "test-management-tooling",
  "version": "1.0.0",
  "description": "Custom test management platform with story-code traceability, manual and automated test execution",
  "main": "dist/index.js",
  "bin": {
    "testmgr": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "package": "npm run build && npm pack",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "test-management",
    "traceability",
    "automation",
    "testing",
    "agile",
    "user-stories",
    "code-coverage"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.962.0",
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/util-dynamodb": "^3.962.0",
    "boxen": "^7.1.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "figlet": "^1.7.0",
    "helmet": "^8.1.0",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "shelljs": "^0.8.5",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/shelljs": "^0.8.15",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
